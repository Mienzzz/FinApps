rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: /users/{userId}
    // Fields: uid, displayName, email, language, theme, currency
    //
    // Collection: /transactions/{transactionId}
    // Fields: uid, type, amount, category, note, date, walletId, toWalletId
    //
    // Collection: /debts/{debtId}
    // Fields: uid, type, personName, amount, remainingAmount, dueDate, status, note
    //
    // Collection: /wallets/{walletId}
    // Fields: uid, name, type, balance, icon
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "firmanmien@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string &&
             data.email is string;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['uid', 'type', 'amount', 'date', 'walletId']) &&
             data.uid == request.auth.uid &&
             data.type in ['income', 'expense', 'transfer'] &&
             data.amount is number &&
             data.date is string;
    }

    function isValidDebt(data) {
      return data.keys().hasAll(['uid', 'type', 'personName', 'amount', 'status']) &&
             data.uid == request.auth.uid &&
             data.type in ['debt', 'receivable'] &&
             data.amount is number &&
             data.status in ['active', 'paid'];
    }

    function isValidWallet(data) {
      return data.keys().hasAll(['uid', 'name', 'type', 'balance']) &&
             data.uid == request.auth.uid &&
             data.name is string &&
             data.type in ['cash', 'bank', 'e-wallet', 'credit'] &&
             data.balance is number;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data);
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(request.resource.data);
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidTransaction(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidTransaction(request.resource.data);
      allow delete: if isDocOwner() || isAdmin();
    }

    match /debts/{debtId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidDebt(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidDebt(request.resource.data);
      allow delete: if isDocOwner() || isAdmin();
    }

    match /wallets/{walletId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidWallet(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidWallet(request.resource.data);
      allow delete: if isDocOwner() || isAdmin();
    }
  }
}
