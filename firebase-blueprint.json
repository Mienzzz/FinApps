{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user preferences and basic info",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "language": { "type": "string", "enum": ["en", "id"] },
        "theme": { "type": "string", "enum": ["light", "dark", "system"] },
        "currency": { "type": "string", "default": "IDR" }
      },
      "required": ["uid", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Income or Expense entry",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner UID" },
        "type": { "type": "string", "enum": ["income", "expense", "transfer"] },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "note": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "walletId": { "type": "string" },
        "toWalletId": { "type": "string", "description": "For transfers" },
        "receiptImage": { "type": "string", "description": "Base64 compressed image" }
      },
      "required": ["uid", "type", "amount", "date", "walletId"]
    },
    "Debt": {
      "title": "Debt / Receivable",
      "description": "Hutang or Piutang entry",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner UID" },
        "type": { "type": "string", "enum": ["debt", "receivable"] },
        "personName": { "type": "string" },
        "amount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "dueDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "paid"] },
        "note": { "type": "string" }
      },
      "required": ["uid", "type", "personName", "amount", "status"]
    },
    "Wallet": {
      "title": "Wallet / Account",
      "description": "Sources of funds (BCA, GoPay, etc)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner UID" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["cash", "bank", "e-wallet", "credit"] },
        "balance": { "type": "number" },
        "icon": { "type": "string" }
      },
      "required": ["uid", "name", "type", "balance"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial transactions"
    },
    "/debts/{debtId}": {
      "schema": "Debt",
      "description": "Debt and receivables"
    },
    "/wallets/{walletId}": {
      "schema": "Wallet",
      "description": "User wallets/accounts"
    }
  }
}
